    <worksheet name='licz_kwar'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>Liczebność per kwartał</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dane_obrobione' name='federated.0v1xswh0aaq2c018i9aj801wqil5' />
          </datasources>
          <datasource-dependencies datasource='federated.0v1xswh0aaq2c018i9aj801wqil5'>
            <column caption='Calculation2' datatype='boolean' name='[Calculation_783344901116387331]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[data_transakcji] &gt;= #2023-01-01# AND [data_transakcji] &lt;= #2026-08-31#' />
            </column>
            <column caption='KWartal z rokiem' datatype='datetime' default-format='*Q&quot; kwartał &quot;yyyy' name='[Calculation_783344901117911045]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;quarter&apos;, [data_transakcji])' />
